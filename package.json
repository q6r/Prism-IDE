{
  "name": "prism-ide",
  "version": "0.3.15",
  "description": "Prism IDE — Claude Code, Codex e várias contas na mesma conversa",
  "author": "Prism",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "host:build": "cd host && cargo build --release",
    "host:test": "cd host && cargo test --release --workspace && cargo clippy --release --workspace --all-targets -- -D warnings",
    "host:types": "cd host && cargo test --release -p prism-protocol export_bindings",
    "dist:win": "npm run remote:build && npm run host:build && electron-vite build && electron-builder --win --config electron-builder.yml",
    "remote:build": "node scripts/build-remote-page.cjs",
    "prebuild": "npm run remote:build",
    "predev": "npm run remote:build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.177",
    "@anthropic-ai/claude-agent-sdk-win32-x64": "0.3.177",
    "@anthropic-ai/sdk": "^0.104.1",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "@monaco-editor/react": "^4.7.0",
    "@pierre/diffs": "1.3.1",
    "@pierre/theme": "2.0.0",
    "@pierre/trees": "1.0.0-beta.6",
    "@xhayper/discord-rpc": "^1.3.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cloudflared": "^0.7.1",
    "echarts": "6.1.0",
    "electron-store": "^8.2.0",
    "html-to-image": "1.11.13",
    "lucide-react": "^1.18.0",
    "monaco-editor": "^0.55.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "4.18.16",
    "remark-gfm": "^4.0.1",
    "ssh2": "^1.17.0",
    "ws": "^8.21.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-builder",
      "esbuild",
      "@homebridge/node-pty-prebuilt-multiarch"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/q6r/Prism-IDE.git"
  },
  "bugs": {
    "url": "https://github.com/q6r/Prism-IDE/issues"
  },
  "homepage": "https://github.com/q6r/Prism-IDE#readme",
  "engines": {
    "node": ">=24.0.0"
  }
}
